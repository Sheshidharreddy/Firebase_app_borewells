rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userRole() {
      return isAuthenticated() && exists(userDocPath())
        ? get(userDocPath()).data.role
        : null;
    }
    
    function isAdmin() {
    
      return userRole() in ['admin', 'super_admin', 'superadmin'];
    }
    
    function isSuperAdmin() {
      return userRole() in ['super_admin', 'superadmin'];
    }
    
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    // Users collection - authenticated users can read their own document
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if false; // Created by AuthService
      allow update: if isSuperAdmin() || isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() && (isOwner(resource.data.ownerId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Maintenance logs collection
    match /maintenanceLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
